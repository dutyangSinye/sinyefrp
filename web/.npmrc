# npm 配置。
#
# 为什么不是默认的 registry.npmjs.org：
#   本机（以及国内多数环境）解析 registry.npmjs.org 会拿到 Cloudflare 的 IPv6 地址，
#   而 Node 默认优先 IPv6，TCP 连接会直接挂起——表现为 npm install 长时间无输出、
#   node_modules 迟迟不出现，且没有任何报错。换成 IPv4 可达的镜像即可。
#
# 注意 --dns-result-order=ipv4first 只能通过环境变量传入（见 scripts/build.ps1 的说明），
# .npmrc 不支持该键。若换到网络正常的机器，本文件可以安全删除。
registry=https://registry.npmmirror.com

# 安装日志保持精简：审计与捐赠提示会淹没真正的错误。
fund=false
audit=false
