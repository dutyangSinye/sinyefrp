# frps 运行配置样板（本机调试用）
#
# 复制为 frps.toml 后修改口令，再执行 start-frps.bat 启动。
#
# 为什么真实文件不入库：
#   它带着本机 Dashboard 的明文口令。口令是「运行实例」的属性而不是
#   项目的属性，记进 git 之后即使删掉也能从历史里翻出来 —— 换口令才是
#   唯一干净的处置，而不入库则连这一步都省了。
#   已在 .gitignore 中排除，本文件是脱敏后的参考。

bindPort = 7000

# Dashboard 与管理 API。只监听环回：
# 改成 0.0.0.0 会把管理接口直接暴露到公网，任何人都能列出全部代理。
webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "admin"

# 改成你自己的值。管理平台连 Dashboard 用的正是这一对凭据：
# 首次初始化时在界面上填写，之后由平台用 DPAPI 加密存入 SQLite；
# 调试期可用环境变量 SINYEFRP_NODE_PASSWORD 覆盖。
webServer.password = "改成你自己的口令"

enablePrometheus = true
